{
  "expo": {
    "name": "GuildChat",
    "slug": "GuildChat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      ["expo-build-properties", { "android": { "newArchEnabled": true }, "ios": { "newArchEnabled": true } }],
      ["./plugins/withAndroidNotificationSound.js", {
        "soundFile": "./assets/alert.wav",
        "destName": "alert.wav"
      }]
    ],
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.vadimkaa75.guildchat",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA", "POST_NOTIFICATIONS", "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"]
    },
    "notification": {
      "sound": "./assets/alert.wav"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2328cf5f-c10d-48c0-83b1-56dd8f6c3f38"
      }
    }
  }
}
