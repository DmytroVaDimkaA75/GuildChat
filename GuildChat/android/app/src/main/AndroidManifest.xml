<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.vadimkaa75.guildchat">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MainApplication"
        android:label="GuildChat"
        android:allowBackup="false"
        android:supportsRtl="true">

        <receiver
            android:name="com.vadimkaa75.guildchat.widgets.GBGTop5SectorsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gbg_top5_info" />
        </receiver>

        <receiver
            android:name="com.vadimkaa75.guildchat.widgets.GBGMapWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gbg_map_info" />
        </receiver>

    </application>

</manifest>
