{
  "expo": {
    "name": "FoEChat",
    "slug": "guildchat",
    "version": "1.0.1",
    "userInterfaceStyle": "dark",
    "icon": "./assets/foechat.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1115"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0f1115",
      "barStyle": "light-content"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/foechat.png",
        "backgroundColor": "#ffffff"        
      },
      "package": "com.vadimkaa75.guildchat",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["RECORD_AUDIO"]
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Дозвольте доступ до мікрофона для запису голосових повідомлень."
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-localization",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "a1245edd-1696-4d26-a080-952f6878196f"
      }
    }
  }
}
