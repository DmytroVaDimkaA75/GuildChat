{
  "manifest_version": 3,
  "name": "FOE GBG Live (DEBUG)",
  "version": "0.6.1",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.forgeofempires.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.forgeofempires.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
"content_security_policy": {
  "extension_pages": "script-src 'self'; connect-src 'self' https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app"
},
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.forgeofempires.com/*"]
    }
  ]
}