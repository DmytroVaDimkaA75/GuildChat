[debug] [2026-08-22T19:46:35.049Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/foechat-b903e/rulesets {"name":"projects/foechat-b903e/rulesets/637d01e5-4a79-4336-9ccf-0c95a63ce9b2","source":{"files":[{"content":"rules_version = '2';\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n    function isImage(maxSizeBytes) {\n      return request.resource != null\n        && request.resource.size <= maxSizeBytes\n        && request.resource.contentType.matches('image/.*');\n    }\n\n    function isAudio(maxSizeBytes) {\n      return request.resource != null\n        && request.resource.size <= maxSizeBytes\n        && (\n          request.resource.contentType.matches('audio/.*')\n          || request.resource.contentType == 'application/octet-stream'\n        );\n    }\n\n    // Images attached to ordinary guild-chat messages.\n    match /images/{fileName} {\n      allow read: if true;\n      allow create, update: if isImage(15 * 1024 * 1024);\n    }\n\n    // Voice messages recorded in guild chats.\n    match /voiceMessages/{chatId}/{fileName} {\n      allow read: if true;\n      allow create, update: if isAudio(25 * 1024 * 1024);\n    }\n\n    // Group-chat avatar.\n    match /guilds/{guildId}/chats/{chatId}/groupAvatar.jpg {\n      allow read: if true;\n      allow create, update: if isImage(5 * 1024 * 1024);\n    }\n\n    // Community avatar.\n    match /communities/{communityId}/avatar.jpg {\n      allow read: if true;\n      allow create, update: if isImage(5 * 1024 * 1024);\n    }\n\n    // Images attached to community-channel posts. The application also\n    // removes these objects when their posts are deleted.\n    match /communityImages/{communityId}/{channelId}/{fileName} {\n      allow read: if true;\n      allow create, update: if isImage(15 * 1024 * 1024);\n      allow delete: if true;\n    }\n\n    // Kept for the legacy ImageUploader component.\n    match /chatImages/{fileName} {\n      allow read: if true;\n      allow create, update: if isImage(15 * 1024 * 1024);\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-08-22T19:46:34.970399Z","metadata":{"services":["firebase.storage"]}}
