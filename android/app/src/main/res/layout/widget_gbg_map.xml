<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@android:color/black">

  <TextView
    android:id="@+id/widgetTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="ПБГ • Мапа"
    android:textSize="16sp"
    android:textStyle="bold"
    android:textColor="@android:color/white"
    android:paddingBottom="8dp"/>

  <TextView
    android:id="@+id/widgetLine1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Власні: 0 • Ворожі: 0"
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="4dp"/>

  <TextView
    android:id="@+id/widgetLine2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Нейтральні: 0 • Штабів: 0"
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="4dp"/>

  <TextView
    android:id="@+id/widgetLine3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Найближчі: ... "
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="4dp"/>

  <TextView
    android:id="@+id/widgetLine4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Фокус: ---"
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="8dp"/>

  <TextView
    android:id="@+id/widgetUpdatedAt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Оновлено: --:--"
    android:textSize="12sp"
    android:textColor="#A0D8FF"/>
</LinearLayout>
