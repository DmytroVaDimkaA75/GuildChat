<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/w_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_rounded"
  android:padding="14dp"
  android:orientation="vertical">

  <TextView
    android:id="@+id/w_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="ПБГ · топ-5 секторів"
    android:textColor="#FFFFFF"
    android:textStyle="bold"
    android:textSize="16sp"
    android:paddingBottom="10dp"/>

  <TextView android:id="@+id/w_line1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"/>
  <TextView android:id="@+id/w_line2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"/>
  <TextView android:id="@+id/w_line3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"/>
  <TextView android:id="@+id/w_line4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"/>
  <TextView android:id="@+id/w_line5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp"/>

</LinearLayout>
