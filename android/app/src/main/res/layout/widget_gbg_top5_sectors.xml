<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@android:color/black">

  <TextView
    android:id="@+id/widgetTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="ПБГ • ТОП-5 секторів"
    android:textSize="16sp"
    android:textStyle="bold"
    android:textColor="@android:color/white"
    android:paddingBottom="8dp"/>

  <TextView
    android:id="@+id/widgetLine1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="1) ..."
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="4dp"/>

  <TextView
    android:id="@+id/widgetLine2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="2) ..."
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="4dp"/>

  <TextView
    android:id="@+id/widgetLine3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="3) ..."
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="4dp"/>

  <TextView
    android:id="@+id/widgetLine4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="4) ..."
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="4dp"/>

  <TextView
    android:id="@+id/widgetLine5"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="5) ..."
    android:textSize="14sp"
    android:textColor="@android:color/white"
    android:paddingBottom="6dp"/>

  <TextView
    android:id="@+id/widgetUpdatedAt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Оновлено: --:--"
    android:textSize="12sp"
    android:textColor="#A0D8FF"/>
</LinearLayout>
